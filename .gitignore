# Only source and persistent instructions are versioned in this data workspace.
/*
!/.gitignore
!/AGENTS.md
!/README.md
!/.agents/
/.agents/*
!/.agents/skills/
/.agents/skills/*
!/.agents/skills/improve-telegram-bridge/
/.agents/skills/improve-telegram-bridge/*
!/.agents/skills/improve-telegram-bridge/SKILL.md
!/.agents/skills/humanizer/
/.agents/skills/humanizer/*
!/.agents/skills/humanizer/SKILL.md
!/.agents/skills/humanizer/LICENSE
!/site/
/site/*
!/site/README.md
!/site/index.html
!/site/app.js
!/site/style.css
!/site/favicon.svg
!/site/build_site.py
!/site/prepare_sources.py
!/site/verify_deployment.py
!/site/send_credentials.py
!/site/humanizer-install.json
!/telegram-bridge/
/telegram-bridge/*
!/telegram-bridge/.gitignore
!/telegram-bridge/.env.example
!/telegram-bridge/README.md
!/telegram-bridge/TELEGRAM.md
!/telegram-bridge/HANDOFF.md
!/telegram-bridge/pyproject.toml
!/telegram-bridge/uv.lock
!/telegram-bridge/desktop-codex
!/telegram-bridge/run.sh
!/telegram-bridge/manage.sh
!/telegram-bridge/start-shared-desktop.command
!/telegram-bridge/src/
/telegram-bridge/src/*
!/telegram-bridge/src/tg_bridge/
/telegram-bridge/src/tg_bridge/*
!/telegram-bridge/src/tg_bridge/*.py
!/telegram-bridge/tests/
/telegram-bridge/tests/*
!/telegram-bridge/tests/test_*.py

# Defense against accidentally tracking data inside an allowed source directory.
**/__pycache__/
*.py[cod]
*.pdf
*.PDF
*.jpg
*.jpeg
*.png
*.heic
*.mp3
*.wav
*.ogg
*.mp4
*.zip
*.sqlite*
*.db
*.log
*.safetensors
*.onnx
*.gguf
.DS_Store
.env
.env.*
!.env.example
