# Only this chat can receive or submit messages. Required, no wildcard.
TG_CHAT_ID=-1000000000000
# Comma-separated user IDs. Empty = every human member of TG_CHAT_ID.
TG_USER_IDS=
# Never put the token in this file or the model environment.
TG_TOKEN_FILE=private/bot-token
CODEX_BIN=/Applications/ChatGPT.app/Contents/Resources/codex-cli/CodexCLI.app/Contents/MacOS/codex
# Blank = private local socket exposed by Desktop through desktop-codex.
CODEX_SOCKET=
WORKSPACE=..
# Existing Desktop chat; use `tg-bridge bind THREAD_ID` while stopped to change it.
CODEX_THREAD_ID=replace-with-your-existing-thread-id
